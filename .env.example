HOST=127.0.0.1
PORT=7676

# Owner password generated by `devspace init` in ~/.devspace/auth.json.
# Set this only for non-interactive or fully env-driven deployments.
# DEVSPACE_OAUTH_OWNER_TOKEN=change-me-to-a-long-random-secret

# Restrict Workbridge to approved local roots.
DEVSPACE_ALLOWED_ROOTS=/home/waishnav/personal,/home/waishnav/work
# Optional Workbridge-only checkout roots for user-level tooling/configuration.
# These roots may be opened directly and may run commands, but cannot be used
# as managed Git worktree sources.
# WORKBRIDGE_AUXILIARY_ROOTS=/home/waishnav/.codex,/home/waishnav/.agents

# Public origin for the tunnel or reverse proxy, without /mcp.
# DEVSPACE_PUBLIC_BASE_URL=https://your-public-host.example.com
# DEVSPACE_ALLOWED_HOSTS=localhost,127.0.0.1,your-public-host.example.com
# DEVSPACE_TRUST_PROXY=1

# Persistent state and managed worktrees.
# DEVSPACE_STATE_DIR=/home/waishnav/.local/share/devspace
# Managed worktrees must stay beneath one DEVSPACE_ALLOWED_ROOTS project root.
# DEVSPACE_WORKTREE_ROOT=/home/waishnav/work/.workbridge/worktrees
# DEVSPACE_WORKSPACE_SESSION_MAX_AGE_DAYS=30

# Logging.
DEVSPACE_LOG_LEVEL=info
DEVSPACE_LOG_FORMAT=json
DEVSPACE_LOG_REQUESTS=1
DEVSPACE_LOG_ASSETS=0
DEVSPACE_LOG_TOOL_CALLS=1
# WORKBRIDGE_LOG_SHELL_COMMANDS=0

# Extra variables passed to exec_command and workspace actions.
# DEVSPACE_CHILD_ENV_ALLOWLIST=AEGIS_GATE_DISCORD_WEBHOOK_URL

# Native-file download is part of the selected upstream Codex surface. Linux hosts can
# execute it; unsupported platforms return an explicit runtime result.
# DEVSPACE_ARTIFACT_MAX_FILE_BYTES=104857600

# Skills are always enabled. Add compatibility or custom skill roots here.
# DEVSPACE_SKILL_PATHS=/home/waishnav/.codex/skills,/home/waishnav/.claude/skills

# Optional OAuth tuning.
# DEVSPACE_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# DEVSPACE_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# DEVSPACE_OAUTH_SCOPES=devspace
# DEVSPACE_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1
# DEVSPACE_OAUTH_MAX_REGISTERED_CLIENTS=50
# DEVSPACE_OAUTH_INACTIVE_CLIENT_MAX_AGE_DAYS=90
# DEVSPACE_OAUTH_AUTH_FAILURE_LIMIT=5
# DEVSPACE_OAUTH_AUTH_FAILURE_WINDOW_SECONDS=300
# DEVSPACE_OAUTH_AUTH_BLOCK_SECONDS=900
# DEVSPACE_OAUTH_AUTH_FAILURE_DELAY_MS=250
