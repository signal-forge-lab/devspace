{
  "name": "@waishnav/devspace",
  "version": "1.0.8-workbridge.2",
  "description": "Expose a secure local coding workspace through an MCP server.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.19 <27"
  },
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "devspace": "bin/devspace.js",
    "devspace-agentd": "bin/devspace-agentd.js"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "desktop/monitor/lib.cjs",
    "desktop/monitor/main.cjs",
    "desktop/monitor/preload.cjs",
    "desktop/monitor/install-windows.ps1",
    "desktop/monitor/package.json",
    "desktop/monitor/package-lock.json",
    "desktop/monitor/memory-log.cjs",
    "desktop/monitor/memory-log.test.cjs",
    "desktop/monitor/supervisor.cjs",
    "desktop/monitor/supervisor.test.cjs",
    "desktop/monitor/test.cjs",
    "desktop/monitor/assets/workbridge-monitor-icon.png",
    "desktop/monitor/assets/workbridge-monitor-icon.ico",
    "assets/workbridge-monitor-icon.png",
    "examples",
    "schema",
    "scripts",
    "skills",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && pnpm build:app && tsc -p tsconfig.build.json",
    "build:app": "vite build",
    "test:serve-lifecycle": "node scripts/cli-serve-smoke.mjs",
    "benchmark:modern-mcp:concurrency": "node scripts/benchmark-modern-mcp-concurrency.mjs",
    "tunnel:launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/workbridge-secure-tunnel-runtime-windows.ps1 -Action connect",
    "tunnel:ensure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/workbridge-secure-tunnel-runtime-windows.ps1 -Action ensure",
    "tunnel:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/workbridge-secure-tunnel-runtime-windows.ps1 -Action status",
    "tunnel:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/workbridge-secure-tunnel-runtime-windows.ps1 -Action stop",
    "tunnel:test": "node scripts/workbridge-secure-tunnel-runtime-windows.test.mjs",
    "baseline:tools:check": "tsx scripts/capture-tool-schema-baseline.ts --check",
    "baseline:tools:print": "tsx scripts/capture-tool-schema-baseline.ts",
    "control": "tsx src/cli.ts control",
    "dev": "tsx watch --clear-screen=false src/cli.ts serve",
    "monitor:launch": "pnpm monitor:tauri:launch",
    "monitor:desktop:install": "npm install --prefix desktop/monitor",
    "monitor:desktop:setup": "npm run setup:win --prefix desktop/monitor",
    "monitor:desktop": "npm start --prefix desktop/monitor",
    "monitor:desktop:launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-monitor-windows.ps1",
    "monitor:desktop:test": "npm test --prefix desktop/monitor",
    "monitor:desktop:pack": "npm run pack:win --prefix desktop/monitor",
    "monitor:desktop:dist": "npm run dist:win --prefix desktop/monitor",
    "monitor:tauri:launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-monitor-tauri-windows.ps1",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "prepack": "pnpm build",
    "schema:config": "tsx scripts/generate-config-schema.ts",
    "start": "node dist/cli.js serve",
    "test": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "coverage:critical": "c8 --config c8.critical.config.json pnpm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "maintenance:worktrees": "node scripts/worktree-hygiene.mjs",
    "verify:rebase": "pnpm typecheck && pnpm lint && pnpm baseline:tools:check && pnpm test && pnpm build && pnpm test:serve-lifecycle && git diff --check && pnpm maintenance:worktrees -- --check"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.1.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.200",
    "@anthropic-ai/sandbox-runtime": "0.0.71",
    "@clack/prompts": "^1.5.1",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@openai/codex-sdk": "^0.142.5",
    "@opencode-ai/sdk": "^1.17.13",
    "@pierre/diffs": "^1.3.6",
    "better-result": "^2.10.0",
    "better-sqlite3": "^12.10.0",
    "cross-spawn": "^7.0.6",
    "diff": "^8.0.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "lucide": "^1.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "semver": "^7.8.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.2",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.14"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.13.1",
    "postcss": "8.5.25",
    "protobufjs": "7.6.5",
    "ws": "8.21.0",
    "undici": "8.10.2"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
